rules_version = '2';

// Money lives on the casino game server (a Cloudflare Worker). It writes
// balances, daily-bonus streaks and poker tables with the Firebase service
// account, which these rules don't apply to. Browsers can only edit their own
// profile (name, settings) and can never touch money, streaks or poker tables.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isDeveloper() {
      return request.auth != null
        && request.auth.token.email == 'c28aa1@dalton.org'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // fields only the game server may write
    function serverOwnedFields() {
      return ['bankroll', 'dailyRewardStreak', 'lastDailyRewardClaimDate'];
    }

    function ownsNewData() {
      return request.resource.data.ownerUid == request.auth.uid;
    }

    match /players/{playerId} {
      // the leaderboard is public
      allow read: if true;

      allow create: if signedIn()
        && ownsNewData()
        && !request.resource.data.keys().hasAny(serverOwnedFields());

      // a record from before ownership existed is claimed by the first browser
      // that saves it; after that only the owner can change it, and never the
      // money or streak fields
      allow update: if signedIn()
        && ownsNewData()
        && resource.data.get('ownerUid', request.auth.uid) == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedFields())
        // the name lock is the developer's: players can't lift it, or rename while locked
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['nameLocked'])
        && (resource.data.get('nameLocked', false) != true
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']));

      // the developer can rename or lock players (money still goes through the
      // server) and delete records
      allow update: if isDeveloper()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedFields());
      allow delete: if isDeveloper();
    }

    match /pokerRooms/{roomCode} {
      // the table is public; only the server writes it
      allow read: if true;
      allow write: if false;

      // each player's own two cards: readable by that player (and the developer)
      match /hands/{playerId} {
        allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isDeveloper());
        allow write: if false;
      }
    }
  }
}
